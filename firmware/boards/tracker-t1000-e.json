{
  "name": "Seeed SenseCAP T1000-E",
  "vendor": "Seeed Studio",
  "url": "https://www.seeedstudio.com/SenseCAP-Card-Tracker-T1000-E-for-Meshtastic-p-5913.html",
  "frameworks": ["arduino"],
  "connectivity": ["bluetooth"],
  "build": {
    "mcu": "nrf52840",
    "cpu": "cortex-m4",
    "f_cpu": "64000000L",
    "core": "nRF5",
    "variant": "Seeed_T1000-E",
    "extra_flags": "-DARDUINO_SEEED_T1000_E -DNRF52840_XXAA",
    "usb_product": "T1000-E",
    "hwids": [
      ["0x2886", "0x0057"],
      ["0x239A", "0x8029"],
      ["0x239A", "0x0029"],
      ["0x239A", "0x002A"],
      ["0x239A", "0x802A"]
    ],
    "bsp": { "name": "adafruit" },
    "arduino": { "ldscript": "nrf52840_s140_v7.ld" },
    "softdevice": {
      "sd_name": "s140",
      "sd_version": "7.3.0",
      "sd_flags": "-DS140",
      "sd_fwid": "0x0123"
    },
    "bootloader": { "settings_addr": "0xFF000" }
  },
  "upload": {
    "protocol": "nrfutil",
    "protocols": ["nrfutil", "jlink", "nrfjprog", "cmsis-dap", "blackmagic"],
    "speed": 115200,
    "maximum_size": 815104,
    "maximum_ram_size": 248832,
    "use_1200bps_touch": true,
    "require_upload_port": true,
    "wait_for_upload_port": true
  },
  "debug": {
    "jlink_device": "nRF52840_xxAA",
    "openocd_target": "nrf52.cfg",
    "svd_path": "nrf52840.svd"
  }
}
