<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer (API 31+). Exclude Keystore-bound
  encrypted prefs — same rationale as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aethermesh_secure_prefs" />
        <exclude domain="sharedpref" path="aethermesh_secure_prefs_fallback" />
        <!-- Paths must match SecurePrefsNames.ENCRYPTED / FALLBACK in Kotlin -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aethermesh_secure_prefs" />
        <exclude domain="sharedpref" path="aethermesh_secure_prefs_fallback" />
        <!-- Paths must match SecurePrefsNames.ENCRYPTED / FALLBACK in Kotlin -->
    </device-transfer>
</data-extraction-rules>
