<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules (API < 31). Keystore-bound encrypted prefs must not be
  backed up: the ciphertext restores but the master key does not, causing a
  crash loop on a new device.
-->
<full-backup-content>
    <!-- Paths must match SecurePrefsNames (plus .xml) and the chat database. -->
    <exclude domain="sharedpref" path="aethermesh_secure_prefs.xml" />
    <exclude domain="sharedpref" path="aethermesh_secure_prefs_fallback.xml" />
    <exclude domain="sharedpref" path="aethermesh_prefs.xml" />
    <exclude domain="database" path="aethermesh.db" />
</full-backup-content>
