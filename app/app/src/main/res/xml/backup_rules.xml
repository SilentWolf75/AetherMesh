<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules (API < 31). Keystore-bound encrypted prefs must not be
  backed up: the ciphertext restores but the master key does not, causing a
  crash loop on a new device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="aethermesh_secure_prefs" />
    <exclude domain="sharedpref" path="aethermesh_secure_prefs_fallback" />
</full-backup-content>
